#!/usr/bin/env python3
"""Argus as an MCP server, for an agent to register: `claude mcp add argus -- argus-mcp`.

A front door onto `argus_mcp.py`, which sits beside it, as `argus-say` is onto the client.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from argus_mcp import main             # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
