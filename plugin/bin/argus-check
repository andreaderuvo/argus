#!/bin/sh
# At the start of an agent's session: is a newer Argus plugin waiting? If so, say it once, in the
# agent itself — a systemMessage is shown to you, not to the model. Asks the Argus on this machine
# (the version in the checkout it runs from); says nothing if Argus is not there or is slow.
set -u
CONF="${ARGUS_CONFIG:-$HOME/.config/argus/config.yaml}"
# Where this machine's Argus answers: the config's own `listen` and, with a certificate, https —
# always on loopback. A fixed http://127.0.0.1:8090 missed every Argus on another port or over TLS
# (2026-10-07: an Argus on https never heard a single hook).
LISTEN="$(sed -n 's/^listen:[[:space:]]*//p' "$CONF" 2>/dev/null | head -1 | tr -d "\"'")"
[ -n "$LISTEN" ] || LISTEN=127.0.0.1:8080
LISTEN="$(printf '%s' "$LISTEN" | sed 's/^0\.0\.0\.0:/127.0.0.1:/; s/^\[::\]:/127.0.0.1:/')"
CERT="$(sed -n 's/^tls_cert:[[:space:]]*//p' "$CONF" 2>/dev/null | head -1 | tr -d "\"'")"
case "$CERT" in ""|null|"~") SCHEME=http ;; *) SCHEME=https ;; esac
URL="${ARGUS_URL:-$SCHEME://$LISTEN}"
TOKEN="${ARGUS_TOKEN:-$(sed -n 's/^token:[[:space:]]*//p' "$CONF" 2>/dev/null | head -1)}"
[ -n "$TOKEN" ] || exit 0
HERE="$(cd "$(dirname "$0")/.." && pwd)"
MINE="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['version'])" "$HERE/.claude-plugin/plugin.json" 2>/dev/null)"
[ -n "$MINE" ] || exit 0
# This session runs plugin $MINE: said to Argus, which marks the window when that falls behind.
if [ -n "${TMUX:-}" ]; then
  SESSION="$(tmux display -p '#S' 2>/dev/null || true)"
  [ -n "$SESSION" ] && curl -sk -m 2 -o /dev/null -X POST "$URL/api/plugin/seen" -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' -d "{\"session\":\"$SESSION\",\"version\":\"$MINE\"}" 2>/dev/null
fi
OFFERED="$(curl -sk -m 2 -H "Authorization: Bearer $TOKEN" "$URL/api/plugin/version" 2>/dev/null \
  | python3 -c "import json,sys; print(json.load(sys.stdin).get('version',''))" 2>/dev/null)"
# Said to the model at the start of every session in tmux: which session it is in, and that Argus's
# tools — not tmux — are how sessions, desks and windows change. Without it an agent asked to
# "rename this session" ran tmux rename-session, and the pages lost the window (2026-11-02).
python3 - "$MINE" "${OFFERED:-}" "${SESSION:-}" <<'PY'
import json, sys
key = lambda v: tuple(int(p) if p.isdigit() else 0 for p in v.split("."))
mine, offered, session = sys.argv[1], sys.argv[2], sys.argv[3]
out = {}
if offered and key(mine) < key(offered):
    out["systemMessage"] = (f"Argus plugin {offered} is available (this session has {mine}): "
                            "/plugin marketplace update argus, /plugin update argus@argus, then /reload-plugins "
                            "— or press Update in Argus → Settings.")
if session:
    out["hookSpecificOutput"] = {"hookEventName": "SessionStart", "additionalContext": (
        f"You run in the tmux session `{session}`, which Argus watches for the person (often from a phone). "
        "You have Argus's MCP tools, named mcp__plugin_argus_argus__<tool>; if they are listed but not loaded, "
        "load them first with ToolSearch (\"select:mcp__plugin_argus_argus__start_agent,"
        "mcp__plugin_argus_argus__who,mcp__plugin_argus_argus__request\" — or by keyword \"argus\"). "
        "Sessions, desks, windows, notes and to-dos change through them, never tmux: no tmux new-session, "
        "rename-session, kill-session or send-keys. Open a new session with an agent: start_agent (launcher "
        "\"Claude Code\" or \"Codex\", name, folder, prompt) — one call, no looking around first. Rename this "
        "session: request rename_session; rename the desk: rename_desk; end a session: request kill_session; "
        "restart on a new version keeping this conversation: request restart_agent; tell another session: who, "
        "then relay; notes: notes / note_*; to-dos and deadlines: todos / todo_add / todo_set; a decision of "
        "theirs: ask; done or failed: ring. `actions` lists what request can ask for. "
        "The person's own Mac or PC (connected through argus-bridge): its browser is yours with browser_open, "
        "browser_look, browser_click, browser_type, browser_eval — they watch it on their screen; a command "
        "there: request computer_run. Never ask them for SSH tunnels, port 9222 or Chrome flags. From a shell: argus-say.")}
if out:
    print(json.dumps(out))
PY
exit 0
