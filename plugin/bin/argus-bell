#!/bin/sh
# Ring the bell in Argus.
#
#   argus-bell [done|asking|failed|note] [text]
#
# The token is read from the Argus config rather than copied in here, so rotating it
# does not leave a stale copy behind.
set -eu

WHY="${1:-done}"
TEXT="${2:-}"
CONF="${ARGUS_CONFIG:-$HOME/.config/argus/config.yaml}"
URL="${ARGUS_URL:-http://127.0.0.1:8090}"

TOKEN="${ARGUS_TOKEN:-$(sed -n 's/^token:[[:space:]]*//p' "$CONF" 2>/dev/null | head -1)}"
[ -n "$TOKEN" ] || exit 0            # no Argus here: say nothing, break nothing

# codex hands its notify program a JSON blob as the last argument. Left alone it would
# become the body of the notification, so the sentence inside it is pulled out instead.
case "$TEXT" in
  '{'*)
    TEXT="$(printf '%s' "$TEXT" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit()
said = d.get('last-assistant-message') or d.get('type') or ''
print(' '.join(str(said).split())[:200])
" 2>/dev/null || true)"
    ;;
esac

# Claude Code and Gemini CLI hand a hook its event as JSON on stdin. For a notification that
# JSON holds the sentence worth reading — "Claude needs your permission to use Bash" — and it
# always holds the id of the conversation, which is what lets Argus resume it after a reboot.
# Read only if something arrives within half a second: a program that leaves its own stdin
# attached and never writes must not hang the hook.
# Not from $CLAUDE_CODE_SESSION_ID: that leaks into everything a Claude shell starts — a tmux
# server started from one hands it to every pane — and would pin a Codex to a Claude's thread.
CONVERSATION=""
if [ ! -t 0 ]; then
  SAID="$(python3 -c "
import json, select, sys
if select.select([sys.stdin], [], [], 0.5)[0]:
    try:
        d = json.loads(sys.stdin.read() or '{}')
    except Exception:
        sys.exit()
    print(str(d.get('session_id') or ''))
    said = d.get('message') or ''
    # Codex (and Claude) asking leave to run something: say what, which is what you decide on.
    if not said and d.get('hook_event_name') == 'PermissionRequest':
        tool = d.get('tool_input') or {}
        what = tool.get('command') or tool.get('file_path') or ''
        said = 'needs your permission to use ' + str(d.get('tool_name') or 'a tool') + (': ' + str(what) if what else '')
    # The end of a Codex turn carries its last words; a done that says what was done.
    if not said and d.get('hook_event_name') == 'Stop':
        said = d.get('last_assistant_message') or ''
    print(' '.join(str(said).split())[:200])
" 2>/dev/null || true)"
  FROM_STDIN="$(printf '%s\n' "$SAID" | sed -n 1p)"
  [ -n "$FROM_STDIN" ] && CONVERSATION="$FROM_STDIN"
  [ -z "$TEXT" ] && TEXT="$(printf '%s\n' "$SAID" | sed -n 2p)"
fi

# Only from inside tmux: outside it, `tmux display` answers for the most recent session on the
# default server — somebody else's — and the bell would be signed with the wrong name.
SESSION=""
[ -n "${TMUX:-}" ] && SESSION="$(tmux display -p '#S' 2>/dev/null || true)"

# Quote for JSON the small way: these fields are a session name and a short sentence.
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037'; }

curl -s -m 5 -o /dev/null -X POST "$URL/api/bell" \
  -H "Authorization: Bearer $TOKEN" \
  -H 'Content-Type: application/json' \
  -d "{\"session\":\"$(esc "$SESSION")\",\"why\":\"$(esc "$WHY")\",\"text\":\"$(esc "$TEXT")\",\"conversation\":\"$(esc "$CONVERSATION")\"}" || true
